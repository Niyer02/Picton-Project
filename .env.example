# Copy to .env and supply your own OpenRouter key. Never share .env.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional: override the local demo's neo4j / picton-local-demo login.
# NEO4J_AUTH=neo4j/your-password
# Optional: otherwise Open WebUI generates and persists its own secret.
# WEBUI_SECRET_KEY=your-persistent-random-secret
# Required only when downloading new SEC filings, not for the bundled demo.
# SEC_USER_AGENT=Your Research Project your-email@example.com
